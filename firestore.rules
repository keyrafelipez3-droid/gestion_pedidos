rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'Administrador'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == true;
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && (
          (request.auth.uid == userId
            && request.resource.data.rol == 'Cliente'
            && request.resource.data.estado == true)
          || isAdmin()
        );
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.estado == resource.data.estado
          && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();

      match /{subcollection}/{documentId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /sucursales/{sucursalId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /horarios/{horarioId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /categorias/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /productos/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /complementos/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /variantes/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /negocios/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}