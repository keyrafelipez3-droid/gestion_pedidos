rules_version = '2';

// Reglas de seguridad de Firestore - sistema multi-tenant.
//
// Principios (rama fix/seguridad):
//  1. Minimo privilegio: cada rol solo toca lo que necesita, y solo de SU
//     negocio. Un Administrador sin negocio asignado no tiene permisos.
//  2. Nadie puede escalar su propio rol, ni cambiarse de negocio/sucursal.
//  3. Los datos personales de los clientes solo los ve el propio cliente
//     y, de forma limitada, el negocio al que le compro.
//  4. Las escrituras validan CAMPOS (affectedKeys) y no solo quien escribe.
//
// Limite conocido: el total de un pedido lo calcula la app. Sin Cloud
// Functions no se puede recalcular en el servidor; el personal ve el
// detalle y el total antes de cobrar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }

    function datosDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function datosUsuarioActual() {
      return datosDe(request.auth.uid);
    }

    function idNegocioActual() {
      return datosUsuarioActual().get('idNegocio', null);
    }

    // El personal solo tiene permisos si esta asignado a un negocio.
    function tieneNegocio() {
      return datosUsuarioActual().get('idNegocio', null) != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && datosUsuarioActual().rol == 'SuperAdmin'
        && datosUsuarioActual().estado == true;
    }

    function isAdmin() {
      return signedIn()
        && datosUsuarioActual().rol == 'Administrador'
        && datosUsuarioActual().estado == true
        && tieneNegocio();
    }

    function isCajero() {
      return signedIn()
        && datosUsuarioActual().rol == 'Cajero'
        && datosUsuarioActual().estado == true
        && tieneNegocio();
    }

    function isCocina() {
      return signedIn()
        && datosUsuarioActual().rol == 'Cocina'
        && datosUsuarioActual().estado == true
        && tieneNegocio();
    }

    function isRepartidor() {
      return signedIn()
        && datosUsuarioActual().rol == 'Repartidor'
        && datosUsuarioActual().estado == true
        && tieneNegocio();
    }

    function esPersonalDelNegocio() {
      return isAdmin() || isCajero() || isCocina();
    }

    // Campos que cambian en una actualizacion.
    function cambios() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Cupon, propina, pedido programado y factura de un pedido nuevo.
    function extrasPedidoValidos(p) {
      return p.get('propina', 0) is number
        && p.get('propina', 0) >= 0
        && p.get('propina', 0) <= 500
        && (p.get('propina', 0) == 0 || p.modalidad == 'Delivery')
        && (p.get('programadoPara', null) == null
            || (p.programadoPara is timestamp
                && p.programadoPara > request.time
                && p.programadoPara < request.time + duration.value(3, 'd')))
        && (p.get('facturaNit', null) == null
            || (p.facturaNit is string && p.facturaNit.size() <= 20
                && p.get('facturaRazonSocial', '') is string
                && p.get('facturaRazonSocial', '').size() <= 80))
        && p.get('descuento', 0) is number
        && p.get('descuento', 0) >= 0
        && (p.get('descuento', 0) == 0 || cuponValido(p));
    }

    // El descuento no puede pasar lo que da el cupon (vigente y activo).
    function cuponValido(p) {
      let cupon = get(/databases/$(database)/documents/negocios/$(p.idNegocio)/cupones/$(p.codigoCupon)).data;
      let subtotal = p.total + p.descuento;
      return p.codigoCupon is string
        && cupon.activo == true
        && (cupon.get('vence', null) == null || cupon.vence > request.time)
        && subtotal >= cupon.get('minimo', 0)
        && p.descuento <= (cupon.tipo == 'porcentaje'
              ? subtotal * cupon.valor / 100 + 0.01
              : cupon.valor + 0.01);
    }

    // Alergias: solo codigos de la lista fija de la app (lib/models/alergenos.dart).
    function alergiasValidas(lista) {
      return lista is list
        && lista.size() <= 13
        && lista.toSet().hasOnly(['mani', 'frutos_secos', 'gluten', 'lacteos', 'huevo',
             'mariscos', 'pescado', 'soya', 'sesamo', 'cebolla', 'tomate', 'ajo', 'picante']);
    }

    // Firma electronica del acuerdo del personal: nombre, CI, version y la
    // hora del servidor (no se puede poner otra fecha).
    function acuerdoValido(a) {
      return a is map
        && a.keys().hasOnly(['version', 'fecha', 'nombre', 'ci', 'idNegocio', 'rol'])
        && a.version is string
        && a.fecha == request.time
        && a.nombre is string && a.nombre.size() >= 3 && a.nombre.size() <= 80
        && a.ci is string && a.ci.size() >= 4 && a.ci.size() <= 20;
    }

    // El cliente fue bloqueado por el Administrador de ese negocio.
    function clienteBloqueado(idNegocio, uid) {
      let ref = /databases/$(database)/documents/negocios/$(idNegocio)/clientes/$(uid);
      return exists(ref) && get(ref).data.get('bloqueado', false) == true;
    }

    // ----------------------------------------------------------- usuarios
    match /usuarios/{userId} {
      // Un Administrador solo ve a su personal. Los datos de los
      // clientes los ve cada negocio en negocios/{id}/clientes.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isSuperAdmin()
          || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual())
        );

      // Auto-registro: solo como Cliente, activo y SIN negocio ni sucursal.
      allow create: if signedIn()
        && (
          (request.auth.uid == userId
            && request.resource.data.rol == 'Cliente'
            && request.resource.data.estado == true
            && request.resource.data.get('idNegocio', null) == null
            && request.resource.data.get('idSucursal', null) == null)
          || isSuperAdmin()
          || (isAdmin()
              && request.resource.data.get('idNegocio', null) == idNegocioActual()
              && request.resource.data.rol in ['Cajero', 'Cocina', 'Repartidor'])
        );

      // - SuperAdmin: todo.
      // - Administrador: solo activa/desactiva o cambia el rol del
      //   personal operativo de SU negocio (Cajero/Cocina/Repartidor). No
      //   toca otros Administradores, ni a si mismo, ni mueve a nadie de
      //   negocio, ni cambia correos.
      // - Cada persona: solo sus datos de perfil. Nunca rol, estado,
      //   correo, negocio ni sucursal.
      allow update: if isSuperAdmin()
        || (isAdmin()
            && userId != request.auth.uid
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && resource.data.rol in ['Cajero', 'Cocina', 'Repartidor']
            && request.resource.data.rol in ['Cajero', 'Cocina', 'Repartidor']
            && request.resource.data.get('idNegocio', null) == resource.data.get('idNegocio', null)
            && request.resource.data.email == resource.data.email
            // La firma del acuerdo y la aceptacion de terminos solo las
            // hace la propia persona.
            && !cambios().hasAny(['acuerdoPersonal', 'terminosVersion', 'terminosAceptadosEn']))
        || (signedIn()
            && request.auth.uid == userId
            && cambios().hasOnly(['nombre', 'telefono', 'fotoPerfil', 'notificacionesActivas', 'alergias',
                                  'acuerdoPersonal', 'terminosVersion', 'terminosAceptadosEn'])
            && alergiasValidas(request.resource.data.get('alergias', []))
            && (!cambios().hasAny(['acuerdoPersonal']) || acuerdoValido(request.resource.data.acuerdoPersonal))
            && (!cambios().hasAny(['terminosVersion', 'terminosAceptadosEn'])
                || (request.resource.data.terminosVersion is string
                    && request.resource.data.terminosAceptadosEn == request.time)));

      // Un Cliente puede eliminar su propia cuenta (requisito de Google
      // Play y Apple). Las cuentas del personal las elimina su Administrador.
      allow delete: if isSuperAdmin()
        || (signedIn()
            && request.auth.uid == userId
            && resource.data.rol == 'Cliente')
        || (isAdmin()
            && userId != request.auth.uid
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && resource.data.rol in ['Cajero', 'Cocina', 'Repartidor']);

      // Carrito, direcciones, favoritos, etc.: SOLO el dueno. Ni el
      // Administrador ni el SuperAdmin necesitan leer las direcciones de
      // un cliente (el pedido guarda su propia copia de la direccion).
      match /{subcollection}/{documentId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // --------------------------------------------- sucursales y catalogo
    match /sucursales/{sucursalId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());

      match /horarios/{horarioId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin()
          || (isAdmin()
              && get(/databases/$(database)/documents/sucursales/$(sucursalId))
                  .data.get('idNegocio', null) == idNegocioActual());
      }

      match /mesas/{mesaId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin()
          || ((isAdmin() || isCajero())
              && get(/databases/$(database)/documents/sucursales/$(sucursalId))
                  .data.get('idNegocio', null) == idNegocioActual());
      }
    }

    match /categorias/{documentId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /productos/{documentId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('idNegocio', null) == idNegocioActual())
        // Control de stock: la Cocina/Caja descuenta lo que se prepara.
        || (esPersonalDelNegocio()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && cambios().hasOnly(['stock', 'disponible'])
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /complementos/{documentId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /variantes/{documentId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    // ----------------------------------------------------------- negocios
    match /negocios/{documentId} {
      allow read: if signedIn();
      // El Administrador edita los datos de SU negocio, pero no puede
      // activarlo/desactivarlo (eso es del SuperAdmin).
      allow update: if isSuperAdmin()
        || (isAdmin()
            && idNegocioActual() == documentId
            && !cambios().hasAny(['estado']));
      allow create, delete: if isSuperAdmin();

      // Cupones de descuento: los lee cualquier usuario con sesion (el
      // cliente escribe el codigo al pagar) y los gestiona el
      // Administrador de este negocio.
      match /cupones/{codigo} {
        allow read: if signedIn();
        allow write: if isSuperAdmin() || (isAdmin() && idNegocioActual() == documentId);
      }

      // Registro de actividad: cada persona escribe SUS acciones (con su uid
      // y la hora del servidor), solo en su negocio. Lo leen el
      // Administrador del negocio y el SuperAdmin. Nadie edita ni borra.
      match /actividad/{idActividad} {
        allow read: if isSuperAdmin() || (isAdmin() && idNegocioActual() == documentId);
        allow create: if signedIn()
          && (isSuperAdmin() || idNegocioActual() == documentId)
          && request.resource.data.idUsuario == request.auth.uid
          && request.resource.data.fecha == request.time
          && request.resource.data.tipo in ['sesion', 'empleado', 'caja', 'pedido', 'catalogo', 'seguridad']
          && request.resource.data.descripcion is string
          && request.resource.data.descripcion.size() <= 300
          && request.resource.data.keys().hasOnly(
               ['tipo', 'descripcion', 'idUsuario', 'nombreUsuario', 'rol', 'fecha']);
        allow update, delete: if false;
      }

      // Clientes de este negocio (se crea al hacer su primer pedido).
      // Guarda solo lo necesario para atenderlo: nombre y telefono. El
      // Administrador lo consulta y puede bloquearlo; el cliente NO puede
      // desbloquearse, ni borrar su registro.
      match /clientes/{clienteId} {
        allow read: if isSuperAdmin()
          || (isAdmin() && idNegocioActual() == documentId)
          || (signedIn() && request.auth.uid == clienteId);

        allow create: if signedIn()
          && request.auth.uid == clienteId
          && request.resource.data.bloqueado == false
          && request.resource.data.keys().hasOnly(
               ['nombre', 'telefono', 'bloqueado', 'fechaPrimerPedido', 'ultimoPedido']);

        allow update: if (signedIn()
            && request.auth.uid == clienteId
            && cambios().hasOnly(['nombre', 'telefono', 'ultimoPedido']))
          || (isAdmin()
            && idNegocioActual() == documentId
            && cambios().hasOnly(['bloqueado', 'motivoBloqueo', 'fechaBloqueo', 'idAdminBloqueo']));

        allow delete: if isSuperAdmin();
      }

      // Resenas de pedidos entregados. El id es el del pedido (una por
      // pedido). Las visibles las lee cualquiera con sesion; las ocultas,
      // solo el Administrador del negocio y la propia autora. Solo el cliente
      // del pedido entregado puede crearla (y no si esta bloqueado en el
      // negocio); solo el Administrador la oculta; el cliente puede borrarla.
      match /resenas/{resenaId} {
        allow read: if isSuperAdmin()
          || (isAdmin() && idNegocioActual() == documentId)
          || (signedIn() && resource.data.estado == 'Visible')
          || (signedIn() && resource.data.idCliente == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.idCliente == request.auth.uid
          && request.resource.data.idPedido == resenaId
          && request.resource.data.idNegocio == documentId
          && request.resource.data.estado == 'Visible'
          && request.resource.data.calificacion is int
          && request.resource.data.calificacion >= 1
          && request.resource.data.calificacion <= 5
          && request.resource.data.comentario is string
          && request.resource.data.comentario.size() <= 500
          && request.resource.data.nombreCliente is string
          && request.resource.data.nombreCliente.size() <= 60
          && request.resource.data.fecha == request.time
          && request.resource.data.keys().hasOnly(
               ['idNegocio', 'idPedido', 'idCliente', 'nombreCliente',
                'calificacion', 'comentario', 'fecha', 'estado'])
          && get(/databases/$(database)/documents/pedidos/$(resenaId)).data.idCliente == request.auth.uid
          && get(/databases/$(database)/documents/pedidos/$(resenaId)).data.estado == 'Entregado'
          && get(/databases/$(database)/documents/pedidos/$(resenaId)).data.get('idNegocio', null) == documentId
          && !clienteBloqueado(documentId, request.auth.uid);

        allow update: if isSuperAdmin()
          || (isAdmin()
              && idNegocioActual() == documentId
              && cambios().hasOnly(['estado', 'motivoModeracion', 'fechaModeracion', 'idAdminModeracion'])
              && request.resource.data.estado in ['Visible', 'Oculta']);

        allow delete: if isSuperAdmin()
          || (signedIn() && resource.data.idCliente == request.auth.uid);
      }
    }

    // ------------------------------------------------------------ pedidos
    // - El Cliente crea SOLO su pedido, en estado Pendiente, sin cobrar,
    //   con campos validos, en una sucursal del negocio indicado y si no
    //   esta bloqueado en ese negocio. No lo modifica despues.
    // - El personal del negocio cambia el estado (cualquier rol operativo)
    //   o registra el cobro (solo Cajero). Nadie edita total, cliente,
    //   negocio, fecha ni detalle de un pedido ya creado.
    // - Nadie borra pedidos salvo el SuperAdmin (datos de prueba).
    match /pedidos/{pedidoId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.idCliente == request.auth.uid)
        || (esPersonalDelNegocio() && resource.data.get('idNegocio', null) == idNegocioActual())
        // Repartidor: solo pedidos de delivery de su negocio que estan
        // listos para tomar o que el mismo tomo.
        || (isRepartidor()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && resource.data.get('modalidad', '') == 'Delivery'
            && (resource.data.get('idRepartidor', null) == request.auth.uid
                || resource.data.estado == 'Listo'));

      allow create: if (signedIn()
          && request.resource.data.idCliente == request.auth.uid
          // El cliente debe haber verificado su correo.
          && request.auth.token.email_verified == true
          && request.resource.data.estado == 'Pendiente'
          && request.resource.data.get('origen', 'cliente') == 'cliente'
          && request.resource.data.get('cobrado', false) == false
          && request.resource.data.get('cuentaAbierta', false) == false
          && request.resource.data.get('idCaja', null) == null
          && request.resource.data.modalidad in ['Recoger', 'Delivery', 'Mesa']
          && request.resource.data.metodoPago in ['Efectivo', 'Transferencia', 'QR']
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && request.resource.data.idNegocio is string
          && request.resource.data.fechaCreacion == request.time
          && request.resource.data.keys().hasOnly(
               ['idCliente', 'idNegocio', 'idSucursal', 'modalidad', 'idMesa',
                'direccionEntrega', 'metodoPago', 'comprobantePagoUrl', 'estado',
                'total', 'notas', 'fechaCreacion', 'origen', 'creadoPor',
                'numeroMesa', 'cuentaAbierta', 'cobrado', 'idCaja',
                'nombreCliente', 'telefonoCliente', 'alergias', 'idiomaCliente',
                'descuento', 'propina', 'codigoCupon', 'programadoPara',
                'facturaNit', 'facturaRazonSocial'])
          && extrasPedidoValidos(request.resource.data)
          && alergiasValidas(request.resource.data.get('alergias', []))
          && request.resource.data.get('idiomaCliente', 'es') in ['es', 'en', 'pt', 'fr']
          && get(/databases/$(database)/documents/sucursales/$(request.resource.data.idSucursal))
               .data.get('idNegocio', null) == request.resource.data.idNegocio
          && !clienteBloqueado(request.resource.data.idNegocio, request.auth.uid))
        // Mesas: el Cajero (o el Administrador) registra pedidos de mesa
        // de SU negocio, a nombre del local.
        || ((isCajero() || isAdmin())
            && request.resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('origen', null) == 'cajero'
            && request.resource.data.estado == 'Pendiente'
            && request.resource.data.get('cobrado', false) == false
            && request.resource.data.get('idCaja', null) == null
            && request.resource.data.get('creadoPor', null) == request.auth.uid
            && alergiasValidas(request.resource.data.get('alergias', []))
            && request.resource.data.total is number
            && request.resource.data.total > 0
            && request.resource.data.fechaCreacion == request.time);

      allow update: if isSuperAdmin()
        // Al eliminar su cuenta, el Cliente desvincula sus pedidos pasados:
        // solo puede quitar su identificador y su direccion de entrega.
        || (signedIn()
            && resource.data.idCliente == request.auth.uid
            && cambios().hasOnly(['idCliente', 'direccionEntrega', 'nombreCliente', 'telefonoCliente'])
            && request.resource.data.idCliente == 'cuenta-eliminada'
            && request.resource.data.get('direccionEntrega', null) == null
            && request.resource.data.get('nombreCliente', null) == null
            && request.resource.data.get('telefonoCliente', null) == null)
        // Repartidor: toma un pedido Listo (queda asignado a el) y luego
        // avisa que llego y lo entrega. Solo cambia estado y sus datos.
        || (isRepartidor()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && resource.data.get('modalidad', '') == 'Delivery'
            && (
              (resource.data.estado == 'Listo'
                && resource.data.get('idRepartidor', null) == null
                && cambios().hasOnly(['estado', 'idRepartidor', 'nombreRepartidor', 'telefonoRepartidor'])
                && request.resource.data.estado == 'En camino'
                && request.resource.data.idRepartidor == request.auth.uid
                && request.resource.data.nombreRepartidor is string
                && request.resource.data.telefonoRepartidor is string)
              // Avisar que llego (solo cambia el estado).
              || (resource.data.get('idRepartidor', null) == request.auth.uid
                && cambios().hasOnly(['estado'])
                && resource.data.estado == 'En camino'
                && request.resource.data.estado == 'En el lugar')
              // Entregar: al cerrar se borra la posicion en vivo.
              || (resource.data.get('idRepartidor', null) == request.auth.uid
                && cambios().hasOnly(['estado', 'ubicacionRepartidor', 'ubicacionActualizada'])
                && resource.data.estado in ['En camino', 'En el lugar']
                && request.resource.data.estado == 'Entregado'
                && request.resource.data.get('ubicacionRepartidor', null) == null
                && request.resource.data.get('ubicacionActualizada', null) == null)
              // Posicion en vivo: solo mientras el pedido esta en camino.
              || (resource.data.get('idRepartidor', null) == request.auth.uid
                && resource.data.estado in ['En camino', 'En el lugar']
                && request.resource.data.estado == resource.data.estado
                && cambios().hasOnly(['ubicacionRepartidor', 'ubicacionActualizada'])
                && request.resource.data.ubicacionRepartidor is latlng
                && request.resource.data.ubicacionActualizada == request.time)
            ))
        || (esPersonalDelNegocio()
            && resource.data.get('idNegocio', null) == idNegocioActual()
            && (
              // Cambio de estado (Cocina, Cajero o Administrador).
              (cambios().hasOnly(['estado'])
                && request.resource.data.estado in ['Pendiente', 'En preparación', 'Listo',
                     'En camino', 'En el lugar', 'Entregado', 'Cancelado'])
              // Cierre de un pedido en camino: tambien se borra la posicion.
              || (cambios().hasOnly(['estado', 'ubicacionRepartidor', 'ubicacionActualizada'])
                && request.resource.data.estado in ['En camino', 'En el lugar', 'Entregado', 'Cancelado']
                && request.resource.data.get('ubicacionRepartidor', null) == null
                && request.resource.data.get('ubicacionActualizada', null) == null)
              // Cobro (solo Cajero): no se puede "des-cobrar" un pedido.
              || (isCajero()
                && cambios().hasOnly(['cuentaAbierta', 'cobrado', 'idCaja', 'metodoPago'])
                && (request.resource.data.get('cobrado', false) == true
                    || resource.data.get('cobrado', false) == false)
                && (!cambios().hasAny(['metodoPago'])
                    || request.resource.data.metodoPago in ['Efectivo', 'Transferencia', 'QR']))
            ));

      allow delete: if isSuperAdmin();

      // Lineas del pedido: se crean junto con el pedido y no se editan.
      // El cliente solo puede agregarlas mientras el pedido sigue Pendiente.
      match /detalle/{detalleId} {
        allow read: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());

        allow create: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.estado == 'Pendiente')
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.estado == 'Pendiente');

        allow update, delete: if isSuperAdmin();
      }

      // Historial de estados: solo se agrega; quien lo agrega queda
      // registrado con su propio uid y la fecha del servidor.
      match /historialEstados/{historialId} {
        allow read: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());

        allow create: if isSuperAdmin()
          || (request.resource.data.idUsuarioQueCambio == request.auth.uid
              && request.resource.data.fecha == request.time
              && (
                (signedIn()
                  && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
                || (esPersonalDelNegocio()
                  && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual())
                || (isRepartidor()
                  && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idRepartidor', null) == request.auth.uid)
              ));

        allow update, delete: if isSuperAdmin();
      }
    }

    // ------------------------------------------------------------- cajas
    match /cajas/{cajaId} {
      function cajaDe(id) {
        return get(/databases/$(database)/documents/cajas/$(id)).data;
      }

      function cajaOperable(id) {
        return cajaDe(id).idCajero == request.auth.uid
          && cajaDe(id).estado == 'Abierta'
          && !('montoContado' in cajaDe(id));
      }

      allow read: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual())
        || (isCajero() && resource.data.get('idCajero', null) == request.auth.uid);

      allow create: if isCajero()
        && request.resource.data.idCajero == request.auth.uid
        && request.resource.data.get('idNegocio', null) == idNegocioActual()
        && request.resource.data.get('idSucursal', null)
            == datosUsuarioActual().get('idSucursal', null)
        && request.resource.data.estado == 'Abierta'
        && request.resource.data.montoInicial is number
        && request.resource.data.montoInicial >= 0
        && !('montoContado' in request.resource.data);

      allow update: if isCajero()
        && resource.data.idCajero == request.auth.uid
        && resource.data.estado == 'Abierta'
        && (
          (!('montoContado' in resource.data)
            && cambios().hasOnly(['montoContado', 'fechaConteo'])
            && request.resource.data.montoContado is number
            && request.resource.data.montoContado >= 0)
          || ('montoContado' in resource.data
            && request.resource.data.estado == 'Cerrada'
            && cambios().hasOnly(['estado', 'fechaCierre', 'montoEsperado', 'diferencia',
                          'observacionCierre', 'totalEfectivo', 'totalTransferencia',
                          'totalQr', 'totalIngresos', 'totalEgresos']))
        );

      allow delete: if false;

      match /movimientos/{movId} {
        allow read: if isSuperAdmin()
          || (isAdmin() && cajaDe(cajaId).get('idNegocio', null) == idNegocioActual())
          || (isCajero() && cajaDe(cajaId).get('idCajero', null) == request.auth.uid);

        allow create: if isCajero()
          && cajaOperable(cajaId)
          && request.resource.data.idUsuario == request.auth.uid
          && request.resource.data.tipo in ['Cobro', 'Ingreso', 'Egreso']
          && request.resource.data.metodoPago in ['Efectivo', 'Transferencia', 'QR']
          && request.resource.data.monto is number
          && request.resource.data.monto > 0
          && (request.resource.data.tipo == 'Cobro'
              || request.resource.data.metodoPago == 'Efectivo');

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
