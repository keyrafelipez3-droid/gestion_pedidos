rules_version = '2';

// Corrección pedida por el docente (post-defensa Sprint 1): el sistema
// ahora es multi-tenant. Un SuperAdmin personaliza TODOS los negocios y
// designa al Administrador de cada uno; un Administrador ya no
// personaliza nada — solo gestiona la operación (sucursales, catálogo,
// empleados) del ÚNICO negocio al que fue asignado (usuarios/{uid}.idNegocio).
//
// NOTA de migración: los documentos creados ANTES de esta corrección no
// tienen el campo `idNegocio`. Por eso todo acceso a ese campo usa
// `.get('idNegocio', null)` en vez de `.idNegocio` — así no se rompen con
// un error de evaluación, simplemente no hacen match con ningún negocio
// hasta que se migren (ver guía al final de este cambio en el chat).
//
// Sprint 2 (HU-24 a HU-32, bloque pedidos): se agregan los roles de
// personal operativo Cajero/Cocina (ya existían en UsuarioModel.Rol, pero
// no tenían funciones propias en las reglas) y las colecciones
// `sucursales/{id}/mesas` y `pedidos` (con sus subcolecciones `detalle` e
// `historialEstados`).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function datosDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function datosUsuarioActual() {
      return datosDe(request.auth.uid);
    }

    function idNegocioActual() {
      return datosUsuarioActual().get('idNegocio', null);
    }

    function isSuperAdmin() {
      return signedIn()
        && datosUsuarioActual().rol == 'SuperAdmin'
        && datosUsuarioActual().estado == true;
    }

    function isAdmin() {
      return signedIn()
        && datosUsuarioActual().rol == 'Administrador'
        && datosUsuarioActual().estado == true;
    }

    // Personal operativo (Sprint 2): Cajero registra/consulta pedidos
    // recibidos y gestiona mesas (HU-29, HU-32); Cocina consulta pedidos
    // pendientes y actualiza el estado de preparación (HU-30, HU-31).
    function isCajero() {
      return signedIn()
        && datosUsuarioActual().rol == 'Cajero'
        && datosUsuarioActual().estado == true;
    }

    function isCocina() {
      return signedIn()
        && datosUsuarioActual().rol == 'Cocina'
        && datosUsuarioActual().estado == true;
    }

    // Cualquier miembro del personal (no Cliente) de un negocio, para no
    // repetir `isAdmin() || isCajero() || isCocina()` en cada regla.
    function esPersonalDelNegocio() {
      return isAdmin() || isCajero() || isCocina();
    }

    match /usuarios/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isSuperAdmin()
          || (isAdmin() && (
                resource.data.rol == 'Cliente'
                || resource.data.get('idNegocio', null) == idNegocioActual()
              ))
        );

      allow create: if signedIn()
        && (
          (request.auth.uid == userId
            && request.resource.data.rol == 'Cliente'
            && request.resource.data.estado == true)
          || isSuperAdmin()
          || (isAdmin()
              && request.resource.data.get('idNegocio', null) == idNegocioActual()
              && request.resource.data.rol in ['Cajero', 'Cocina', 'Repartidor'])
        );

      // Nota: un Administrador puede actualizar (activar/desactivar,
      // cambiar rol) a su propio personal, pero NUNCA puede ascender a
      // nadie a 'Administrador' ni a 'SuperAdmin' — designar
      // Administradores es exclusivo del SuperAdmin.
      // Nota (encontrado al revisar junto con Alaitz): un Administrador
      // NUNCA puede modificar su PROPIO documento por esta rama, aunque
      // técnicamente cumpliera las condiciones — si no, podría
      // desactivarse o cambiarse el rol a sí mismo y quedar bloqueado del
      // panel sin que nadie más lo note. Para su propio documento solo
      // aplica la rama de "signedIn()" de más abajo, que no deja tocar
      // rol/estado/email.
      allow update: if isSuperAdmin()
        || (isAdmin() && userId != request.auth.uid && (
              (resource.data.rol == 'Cliente' && request.resource.data.rol == 'Cliente')
              || (resource.data.get('idNegocio', null) == idNegocioActual()
                  && request.resource.data.rol in ['Cajero', 'Cocina', 'Repartidor'])
            ))
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.estado == resource.data.estado
          && request.resource.data.email == resource.data.email);

      // Mismo criterio que en "update": un Administrador no puede
      // borrar su PROPIO documento (se bloquearía a sí mismo del panel).
      allow delete: if isSuperAdmin()
        || (isAdmin() && userId != request.auth.uid && (
              resource.data.rol == 'Cliente'
              || resource.data.get('idNegocio', null) == idNegocioActual()
            ));

      // Subcolecciones propias del cliente/usuario: direcciones,
      // favoritos, notificaciones, carritoItems, etc. El dueño siempre
      // puede leer/escribir las suyas; el Administrador de un negocio (o
      // cualquier Administrador si el dueño es Cliente) y el SuperAdmin
      // también, igual que ya pasaba antes de Sprint 2 — por eso
      // favoritos/carritoItems no necesitaron una regla nueva aparte.
      match /{subcollection}/{documentId} {
        allow read, write: if isSuperAdmin()
          || (isAdmin() && (
                datosDe(userId).rol == 'Cliente'
                || datosDe(userId).get('idNegocio', null) == idNegocioActual()
              ))
          || (signedIn() && request.auth.uid == userId);
      }
    }

    match /sucursales/{sucursalId} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());

      match /horarios/{horarioId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin()
          || (isAdmin()
              && get(/databases/$(database)/documents/sucursales/$(sucursalId))
                  .data.get('idNegocio', null) == idNegocioActual());
      }

      // HU-32: Cajero gestiona mesas y pedidos desde mesa (además del
      // Administrador/SuperAdmin). Cocina NO necesita tocar mesas.
      match /mesas/{mesaId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin()
          || ((isAdmin() || isCajero())
              && get(/databases/$(database)/documents/sucursales/$(sucursalId))
                  .data.get('idNegocio', null) == idNegocioActual());
      }
    }

    match /categorias/{documentId} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /productos/{documentId} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /complementos/{documentId} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /variantes/{documentId} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        || (isAdmin() && request.resource.data.get('idNegocio', null) == idNegocioActual());
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual());
    }

    match /negocios/{documentId} {
      allow read: if signedIn();
      // Sprint 2: el Administrador ahora edita "Datos del negocio" (HU-24,
      // QR de pago incluido) desde su propio panel, no solo el SuperAdmin
      // — pero SOLO puede actualizar el negocio al que está asignado, y no
      // puede crear negocios nuevos ni borrarlos (eso sigue siendo
      // exclusivo del SuperAdmin, que es quien da de alta cada negocio).
      allow update: if isSuperAdmin()
        || (isAdmin() && idNegocioActual() == documentId);
      allow create, delete: if isSuperAdmin();
    }

    // Sprint 2, HU-24 a HU-31: pedidos del cliente.
    //
    // - El Cliente SOLO puede crear su propio pedido (idCliente ==
    //   su uid) y con estado inicial 'Pendiente' — así no puede
    //   crearlo ya 'Entregado' o manipular el flujo. Una vez creado, el
    //   cliente ya NO puede modificarlo (evita que cambie el total o el
    //   estado él mismo); solo puede leerlo (HU-28: consultar detalle).
    // - El personal del negocio (Administrador/Cajero/Cocina) y el
    //   SuperAdmin pueden leer y actualizar (cambiar estado, etc.) los
    //   pedidos de SU negocio. No se distingue aquí qué estados puede
    //   poner cada rol (ej. que Cocina no marque "Entregado") porque
    //   Firestore Rules no valida transiciones de máquina de estados de
    //   forma práctica sin duplicar mucha lógica; esa validación queda
    //   del lado de la app (servicios), como ya se hace con otros flujos.
    // - Nadie borra pedidos (ni Admin): quedan como historial. Solo
    //   SuperAdmin puede, por si hace falta limpiar datos de prueba.
    match /pedidos/{pedidoId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.idCliente == request.auth.uid)
        || (esPersonalDelNegocio() && resource.data.get('idNegocio', null) == idNegocioActual());

      allow create: if (signedIn()
          && request.resource.data.idCliente == request.auth.uid
          && request.resource.data.estado == 'Pendiente')
        // Mesas: el Cajero (o el Administrador) registra pedidos de mesa de
        // SU negocio a nombre del local, sin cuenta de cliente detrás.
        || ((isCajero() || isAdmin())
            && request.resource.data.get('idNegocio', null) == idNegocioActual()
            && request.resource.data.get('origen', null) == 'cajero'
            && request.resource.data.estado == 'Pendiente');

      allow update: if isSuperAdmin()
        || (esPersonalDelNegocio()
            && resource.data.get('idNegocio', null) == idNegocioActual());

      allow delete: if isSuperAdmin();

      // DetallePedido: las líneas del pedido (productos, cantidades,
      // variantes/complementos, precios "congelados" al confirmar).
      // Se crean junto con el pedido y no se vuelven a editar, así que
      // el cliente solo necesita leerlas (HU-28); el personal del
      // negocio también las puede crear (ej. Cajero registra un pedido
      // telefónico) y leer.
      match /detalle/{detalleId} {
        allow read: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());

        allow create: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());

        allow update, delete: if isSuperAdmin()
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());
      }

      // HistorialEstadoPedido: un renglón por cada cambio de estado
      // (HU-30/HU-31: Cocina consulta pendientes y actualiza
      // preparación; HU-29: Cajero registra/consulta). Es un historial,
      // así que nunca se edita ni se borra, solo se agrega.
      match /historialEstados/{historialId} {
        allow read: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());

        // Bug encontrado probando (Alaitz, cuenta Cliente real): faltaba
        // dejar que el Cliente dueño del pedido cree el PRIMER renglón
        // del historial ('Pendiente') al confirmar su propio pedido —
        // antes solo se lo permitía a personal del negocio/SuperAdmin,
        // así que PedidoService.confirmarPedido() fallaba completo para
        // cualquier Cliente real (funcionaba de casualidad probando con
        // una cuenta Administrador, porque esa sí cae en
        // esPersonalDelNegocio()).
        allow create: if isSuperAdmin()
          || (signedIn()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.idCliente == request.auth.uid)
          || (esPersonalDelNegocio()
              && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('idNegocio', null) == idNegocioActual());

        allow update, delete: if isSuperAdmin();
      }
    }

    // HU-46: caja del Cajero (un turno = una caja) y sus movimientos.
    // Una caja por Cajero y por turno. Los movimientos nunca se editan ni
    // se borran: un error se corrige con un movimiento contrario.
    match /cajas/{cajaId} {
      function cajaDe(id) {
        return get(/databases/$(database)/documents/cajas/$(id)).data;
      }

      // Caja en la que el Cajero puede registrar movimientos: es suya,
      // sigue Abierta y todavia no registro el conteo del cierre.
      function cajaOperable(id) {
        return cajaDe(id).idCajero == request.auth.uid
          && cajaDe(id).estado == 'Abierta'
          && !('montoContado' in cajaDe(id));
      }

      allow read: if isSuperAdmin()
        || (isAdmin() && resource.data.get('idNegocio', null) == idNegocioActual())
        || (isCajero() && resource.data.get('idCajero', null) == request.auth.uid);

      allow create: if isCajero()
        && request.resource.data.idCajero == request.auth.uid
        && request.resource.data.get('idNegocio', null) == idNegocioActual()
        && request.resource.data.get('idSucursal', null)
            == datosUsuarioActual().get('idSucursal', null)
        && request.resource.data.estado == 'Abierta'
        && request.resource.data.montoInicial is number
        && request.resource.data.montoInicial >= 0
        && !('montoContado' in request.resource.data);

      // Cierre ciego en dos pasos: 1) registrar el conteo (una sola vez),
      // 2) cerrar con los totales. Una caja cerrada no se vuelve a tocar.
      allow update: if isCajero()
        && resource.data.idCajero == request.auth.uid
        && resource.data.estado == 'Abierta'
        && (
          (!('montoContado' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['montoContado', 'fechaConteo'])
            && request.resource.data.montoContado is number
            && request.resource.data.montoContado >= 0)
          || ('montoContado' in resource.data
            && request.resource.data.estado == 'Cerrada'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['estado', 'fechaCierre', 'montoEsperado', 'diferencia',
                          'observacionCierre', 'totalEfectivo', 'totalTransferencia',
                          'totalQr', 'totalIngresos', 'totalEgresos']))
        );

      allow delete: if false;

      match /movimientos/{movId} {
        allow read: if isSuperAdmin()
          || (isAdmin() && cajaDe(cajaId).get('idNegocio', null) == idNegocioActual())
          || (isCajero() && cajaDe(cajaId).get('idCajero', null) == request.auth.uid);

        allow create: if isCajero()
          && cajaOperable(cajaId)
          && request.resource.data.idUsuario == request.auth.uid
          && request.resource.data.tipo in ['Cobro', 'Ingreso', 'Egreso']
          && request.resource.data.metodoPago in ['Efectivo', 'Transferencia', 'QR']
          && request.resource.data.monto is number
          && request.resource.data.monto > 0
          && (request.resource.data.tipo == 'Cobro'
              || request.resource.data.metodoPago == 'Efectivo');

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
