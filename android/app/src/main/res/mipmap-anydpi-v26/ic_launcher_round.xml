<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono adaptativo (Android 8+): fondo negro de la marca y el logo de Caro
     dentro de la zona segura, así ningún launcher lo recorta ni le pone un
     fondo blanco. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/caro_negro"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
